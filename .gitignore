# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
__MACOSX

# Windows image file caches
Thumbs.db
ehthumbs.db

# Ignore configstore json files
**/configstore/**/*.json

# Ignore stripe config
**/stripe/config.toml

# Local Git worktrees
.worktrees/

# Lima local overrides and generated state
.lima/
lima/*.local.yaml
.cider-lima-backups/

# Local credentials and environment overrides
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.*.example
*.key
*.pem

# Archived OpenSpec changes
/openspec/changes/archive/

# Yazelix upgrade backups
/symlinks/.config/yazelix/**/*backup*
