{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "$HOME/.cider/symlinks/factory/droid-status-report.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "$HOME/.cider/symlinks/factory/droid-status-report.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "Notification": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "$HOME/.cider/symlinks/factory/droid-status-report.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "$HOME/.cider/symlinks/factory/droid-status-report.sh",
          "timeout": 5
        }
      ]
    }
  ]
}
