[Unit]
Description=Start the Lima Codex app-server daemon
Requires=codex-lima-overlay.service
After=codex-lima-overlay.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=blesscat
WorkingDirectory=/home/blesscat.guest
Environment=HOME=/home/blesscat.guest
Environment=CODEX_HOME=/Users/blesscat/.codex
Environment=TMPDIR=/home/blesscat.guest/.local/state/codex-tmp
Environment=PATH=/home/blesscat.guest/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/Users/blesscat/.codex/packages/standalone/current/codex app-server daemon start
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
